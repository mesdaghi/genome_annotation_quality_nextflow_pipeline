// Change this to your desired Singularity image directory
params.singularity_image_dir = '/mnt/sdd1/luc/singularity_images' 
params.scratch_dir = false

executor {
    queueSize = 50
    submitRateLimit = '5 sec'
}

// Individual process configuration are defined here 
process { 

    withLabel: 'gpu' {
        queue = 'gpu'
        clusterOptions = '--gres=gpu:1 --exclusive --distribution=block:cyclic'
        cpus = 8
        memory = '16 GB'
        time = '2d'
    }

    withLabel: 'cpu' {
        clusterOptions = ''
        cpus = 1
        memory = '2 GB'
        time = '1h'
        errorStrategy = 'retry'
        maxRetries = 3
}
        



   withName: '.*' {
        cache     = 'lenient'
        container = "${params.singularity_image_dir}/GAQA_bash.sif"
        errorStrategy = 'retry'
        
    }

    withName: 'FASTA_TO_JSON' {
        container = "${params.singularity_image_dir}/GAQA_python.sif"

    }

    withName: 'GENERATE_REPORT' {
        container = "${params.singularity_image_dir}/GAQA_python.sif"

        time = '30m'
    }

    withName: 'METAPREDICT_DISORDER' {
        container = "${params.singularity_image_dir}/GAQA_metapredict.sif"
        cpus = 8
        memory = '16 GB'
        time = '2d'
    }

    withName: 'PLOT_METAPREDICT' {
        
        container = "${params.singularity_image_dir}/GAQA_python.sif"
   

    }
    
    withName: 'PLOT_PLDDT' {
        container = "${params.singularity_image_dir}/GAQA_python.sif"
        memory = '4 GB'
        time = '2h'
    }

    withName: 'PLOT_PSAURON' {
        container = "${params.singularity_image_dir}/GAQA_python.sif"
        cpus = 2
        memory = '4 GB'
        time = '2h'
    }

    withName: 'PROCESS_MODELS' {
        container = "${params.singularity_image_dir}/GAQA_python.sif"
        cpus = 4
        memory = '8 GB'
        time = '4h'
    }

    withName: 'PROTENIX_PREDICT' {
        container = "${params.singularity_image_dir}/GAQA_protenix.sif"
        cpus = 8
        memory = '16 GB'
        time = '2d'
	beforeScript = "mkdir -p ${params.singularity_image_dir}/apptainer-tmp/protenix_cache && cp -rn ${params.protenix_cache}/. ${params.singularity_image_dir}/apptainer-tmp/protenix_cache/"
        containerOptions = "--nv --bind ${projectDir}/../bin/ps:/usr/bin/ps --bind ${projectDir}/../bin/ld-musl-x86_64.so.1:/tmp/pslib/ld-musl-x86_64.so.1 --bind ${projectDir}/../bin/libintl.so.8:/tmp/pslib/libintl.so.8 --bind ${projectDir}/../bin/libproc2.so.1:/tmp/pslib/libproc2.so.1 --bind ${projectDir}/../bin/libskarnet.so.2.14:/tmp/pslib/libskarnet.so.2.14 --bind ${projectDir}/../bin/libutmps.so.0.1:/tmp/pslib/libutmps.so.0.1 --bind ${projectDir}/../bin/ps-real:/tmp/ps --bind ${params.singularity_image_dir}/apptainer-tmp/protenix_cache:${params.protenix_cache}"
    }

    withName: 'PSAURON_RUN' {
        container = "${params.singularity_image_dir}/GAQA_psauron.sif"
        cpus = 8
        memory = '16 GB'
        time = '2d'

    }

    withName: 'SPLIT_JSON' {
        container = "${params.singularity_image_dir}/GAQA_python.sif"
    }

    withName: 'INTERPROSCAN' {
        container = "${params.singularity_image_dir}/GAQA_interproscan.sif"
        cpus = 16
        memory = '64 GB'
        time = '24h'
    }

    withName: 'CONCAT_IPR' {
        container = "${params.singularity_image_dir}/GAQA_python.sif"
    }

    withName: 'CHUNK_IPR' {
        container = "${params.singularity_image_dir}/GAQA_bash.sif"

    }
    withName: 'PLOT_INTERPRO' {
        container = "${params.singularity_image_dir}/GAQA_python.sif"
        cpus = 2
        memory = '4 GB'
        time = '2h'
    }



}
