profiles {
    slurm {
        params {
            chunk_size = 100  // default sequences per JSON chunk
        }

        process {
            executor = 'slurm'
            cpus = 8
            memory = '16 GB'
            time = '2d'
            maxRetries = 2
            queueSize = 50
        }
    }
}

// Explicit queue and clusterOptions for every process
process {

    // ── GPU processes ──────────────────────────────────────────
    withName: PROTENIX_PREDICT {
        queue = 'gpu'
        clusterOptions = '--gres=gpu:1 --exclusive --distribution=block:cyclic'
    }
    withName: METAPREDICT_DISORDER {
        queue = 'gpu'
        clusterOptions = '--gres=gpu:1 --exclusive --distribution=block:cyclic'
    }
    withName: PSAURON_RUN {
        queue = 'gpu'
        clusterOptions = '--gres=gpu:1 --exclusive --distribution=block:cyclic'
    }

    // ── CPU processes ──────────────────────────────────────────
    withName: FASTA_TO_JSON {
        queue = 'low'
        clusterOptions = '--exclusive --distribution=block:cyclic'
    }
    withName: SPLIT_JSON {
        queue = 'low'
        clusterOptions = '--exclusive --distribution=block:cyclic'
    }
    withName: COLLECT_CHUNKS {
        queue = 'low'
        clusterOptions = '--exclusive --distribution=block:cyclic'
    }
    withName: PROCESS_MODELS {
        queue = 'low'
        clusterOptions = '--exclusive --distribution=block:cyclic'
    }
    withName: PLOT_PLDDT {
        queue = 'low'
        clusterOptions = '--exclusive --distribution=block:cyclic'
    }
    withName: PLOT_METAPREDICT {
        queue = 'low'
        clusterOptions = '--exclusive --distribution=block:cyclic'
    }
    withName: PLOT_PSAURON {
        queue = 'low'
        clusterOptions = '--exclusive --distribution=block:cyclic'
    }
    withName: GENERATE_REPORT {
        queue = 'low'
        clusterOptions = '--exclusive --distribution=block:cyclic'
    }
    withName: CHUNK_IPR {
        queue = 'low'
        clusterOptions = '--exclusive --distribution=block:cyclic'
    }
    withName: INTERPROSCAN {
        queue = 'low'
        cpus = 16
        memory = '64 GB'
        time = '24h'
        clusterOptions = '--exclusive --distribution=block:cyclic'
    }
    withName: CONCAT_IPR {
        queue = 'low'
        clusterOptions = '--exclusive --distribution=block:cyclic'
    }
    withName: PLOT_INTERPRO {
        queue = 'low'
        clusterOptions = '--exclusive --distribution=block:cyclic'
    }
}

